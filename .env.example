# =============================================================================
# DecoAI Assistant - environment template
# =============================================================================
# Copy this file to .env (next to setup.ps1) and fill in the values you need,
# THEN run setup.ps1. Setup reads this file, adds the machine-specific paths it
# resolves for you, and writes the result to <workspace>\Skills\.env - which is
# the file every skill CLI actually loads at runtime.
#
# Everything here is optional. Anything left blank falls back to mock data or a
# safe default, so the system still starts - it just will not talk to that
# particular backend.
#
# Values are read literally: do not quote them and do not put comments on the
# same line as a value.
# =============================================================================


# -----------------------------------------------------------------------------
# Paths - LEAVE THESE BLANK
# -----------------------------------------------------------------------------
# setup.ps1 fills these in from the workspace directory you choose when it runs.
# Only set them by hand if you are pointing several machines at one shared
# location (for example a network share holding the inventory database).

# Shared SQLite inventory DB. Both inventory-management and cost-estimation
# read and write this single file.
DECOAI_DB_PATH=

# Where generated concept images are written.
DECOAI_OUTPUT_DIR=

# Folder holding the precompiled SD2.1 QNN package: text_encoder.onnx,
# unet.onnx, vae.onnx, metadata.json and the *_qairt_context.bin siblings.
SD21_MODEL_DIR=

# Python 3.12 ARM64 interpreter for the SD2.1 pipeline. generate_cli.py uses it
# to run generate.py and the session server in their own environment.
SD21_PYTHON=

# Hugging Face cache. Only used to download the CLIP tokenizer on first run.
HF_HOME=


# -----------------------------------------------------------------------------
# Anthropic - the primary agent model (anthropic/claude-sonnet-5)
# -----------------------------------------------------------------------------
# Required for the OpenClaw agent itself. Without it the gateway starts but the
# agent cannot answer.
ANTHROPIC_API_KEY=


# -----------------------------------------------------------------------------
# Cirrascale AI Suite - cloud image generation
# -----------------------------------------------------------------------------
# Required by Skills/image-generation/generate_cli.py and concepts_cli.py.
# Without it, only the local SD2.1 NPU path can produce images.
CIRRASCALE_API_KEY=


# -----------------------------------------------------------------------------
# Invoice reading (inventory-management)
# -----------------------------------------------------------------------------
# Point at any OpenAI-compatible /v1 endpoint. Leave all three blank to fall
# back to ANTHROPIC_API_KEY, and blank again to fall back to mock line items.
INVOICE_READ_MODEL_URL=
INVOICE_READ_MODEL_NAME=
INVOICE_READ_API_KEY=


# -----------------------------------------------------------------------------
# Decoration photo analysis (inventory-management)
# -----------------------------------------------------------------------------
# Same fallback chain as above. To use the local Geniex Qwen2.5-VL server that
# start.ps1 launches, set:
#   IMAGE_READ_MODEL_URL=http://127.0.0.1:18181/v1
IMAGE_READ_MODEL_URL=
IMAGE_READ_MODEL_NAME=
IMAGE_READ_API_KEY=

# Model Geniex serves for image understanding.
GENIEX_MODEL=ai-hub-models/Qwen2.5-VL-7B-Instruct


# -----------------------------------------------------------------------------
# Shelf refresh - Arduino Uno Q camera and vision service
# -----------------------------------------------------------------------------
# refresh_cli.py takes counts from the Uno Q first, then ARDUINO_URL, then dummy
# data. The Uno Q path shells out to the unoq skill, which reaches the board
# over adb - so the board must be connected by USB and running its VLM
# (adb shell 'bash ~/start_vlm.sh').

# The unoq skill's counting script. setup.ps1 fills this in; the default is the
# UnoQ-ESP32-VLM folder sitting next to the other skills.
UNOQ_SCRIPT=

# How long to wait on the board's VLM. Counting a shelf on Qwen3.5-2B takes
# minutes, so this is deliberately generous.
UNOQ_TIMEOUT_SECONDS=900

# Base URL of an HTTP bin-counting service, used when the Uno Q is unavailable.
# Leave blank and refresh_cli.py falls back to dummy counts.
#   ARDUINO_URL=http://uno-q.local:8080
ARDUINO_URL=

# Stock at or below this count is flagged for reorder.
REORDER_THRESHOLD=5

# Poll interval for external schedulers, in seconds.
REFRESH_INTERVAL_SECONDS=300


# -----------------------------------------------------------------------------
# Cost estimation - price lookup
# -----------------------------------------------------------------------------
# Currently unused: pricing comes from the inventory DB. Kept for the optional
# SerpAPI / predicted-price backends in cost-estimation/app/price_lookup.py.
SERPAPI_KEY=
PRICE_LOOKUP_URL=
PRICE_PREDICT_MODEL_URL=
PRICE_PREDICT_MODEL_NAME=
PRICE_PREDICT_API_KEY=


# -----------------------------------------------------------------------------
# Amazon URL builder
# -----------------------------------------------------------------------------
# Affiliate tag appended to generated purchase links. Blank means plain links.
AMAZON_AFFILIATE_TAG=

# Port for the Node service started by start.ps1.
AMAZON_BUILDER_PORT=8004


# -----------------------------------------------------------------------------
# Telegram - owner notifications and chat channel
# -----------------------------------------------------------------------------
# Get a token from @BotFather. Get your chat id from @userinfobot.
# Both must be set for setup.ps1 to enable the Telegram channel.
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_CHAT_ID=


# -----------------------------------------------------------------------------
# TLS
# -----------------------------------------------------------------------------
# Set to true only when a model endpoint uses a self-signed certificate.
DECOAI_INSECURE_SSL=false
